{
  "name": "impulse-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:native": "node scripts/dev-infra-native.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:e2e": "turbo run test:e2e --concurrency=1",
    "arch:check": "depcruise apps packages --config .dependency-cruiser.cjs && node scripts/check-table-ownership.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @impulse/api db:generate",
    "db:migrate": "pnpm --filter @impulse/api db:migrate",
    "db:deploy": "pnpm --filter @impulse/api db:deploy",
    "db:seed": "pnpm --filter @impulse/api db:seed"
  },
  "devDependencies": {
    "dependency-cruiser": "18.7.0",
    "embedded-postgres": "18.6.0-beta.19",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "valkey-wasm": "0.1.1"
  }
}
