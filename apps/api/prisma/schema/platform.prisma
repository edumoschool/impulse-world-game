// Owners: modules/audit (audit_logs), infrastructure/events (outbox_events, consumed_events).

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

/// Append-only: the runtime role has no UPDATE or DELETE grant. There are deliberately no
/// foreign keys, so the trail outlives the rows it describes. Never store names or free text.
model AuditLog {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String?      @map("tenant_id") @db.Uuid
  actorUserId String?      @map("actor_user_id") @db.Uuid
  action      String
  targetType  String?      @map("target_type")
  targetId    String?      @map("target_id")
  outcome     AuditOutcome @default(SUCCESS)
  requestId   String?      @map("request_id")
  metadata    Json         @default("{}")
  occurredAt  DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@index([action, occurredAt(sort: Desc)])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String?   @map("tenant_id") @db.Uuid
  type          String
  version       Int
  aggregateId   String    @map("aggregate_id") @db.Uuid
  correlationId String    @map("correlation_id")
  payload       Json
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)

  @@index([publishedAt, occurredAt])
  @@map("outbox_events")
}

/// Holds identifiers only, so it is safe as a global table.
model ConsumedEvent {
  eventId    String   @map("event_id") @db.Uuid
  consumer   String
  consumedAt DateTime @default(now()) @map("consumed_at") @db.Timestamptz(6)

  @@id([eventId, consumer])
  @@map("consumed_events")
}
