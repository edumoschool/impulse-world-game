# Copy to .env with `pnpm setup:env`, which generates real secrets.
# Values below only work against the local docker-compose stack.

NODE_ENV=development
LOG_LEVEL=info
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Runtime role. Row-level security applies. Never point this at a superuser or owner.
DATABASE_URL=postgresql://impulse_app:app_dev_only@127.0.0.1:5544/impulse
# BYPASSRLS role for the outbox relay and audited platform operations.
SYSTEM_DATABASE_URL=postgresql://impulse_system:system_dev_only@127.0.0.1:5544/impulse
# Table owner. Used by migrations only and never loaded by the running API.
MIGRATION_DATABASE_URL=postgresql://impulse_owner:owner_dev_only@127.0.0.1:5544/impulse
DATABASE_POOL_MAX=20

REDIS_URL=redis://127.0.0.1:6380/0

S3_ENDPOINT=http://127.0.0.1:9100
S3_REGION=us-east-1
S3_BUCKET=impulse-dev
S3_ACCESS_KEY=impulse_dev
S3_SECRET_KEY=impulse_dev_secret
S3_FORCE_PATH_STYLE=true

SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_FROM=IMPULSE WORLD <no-reply@impulse.local>

# Generated by `pnpm setup:env`. Each must be at least 32 characters.
AUTH_JWT_SECRET=
AUTH_CSRF_SECRET=
# 32 bytes, base64. Encrypts MFA secrets at rest.
AUTH_ENCRYPTION_KEY=
METRICS_TOKEN=

ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_REUSE_GRACE_SECONDS=10

# Optional. Telemetry stays off until these are set.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
